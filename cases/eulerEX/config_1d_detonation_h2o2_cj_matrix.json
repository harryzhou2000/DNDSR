{
  "$schema": "../eulerEX_schema.json",
  "caseNotes": {
    "/**/": {
      "purpose": "Base configuration for the new fitted-profile H2/O2 detonation split/ODE matrix on the 12.5 mm, 5000-cell grid.",
      "reference": "Use the observed-order fixed-mesh timestep-limit speed D0=2798.224963262598 m/s as the matrix baseline. The independent SDToolbox/Cantera CJ speed is 2836.381883789159 m/s.",
      "spatialResolution": "Uniform_01_5000.cgns with meshScale=0.0125 gives h=2.5 um and about 20 cells across the fitted 50.04 um induction length. Spatial convergence is deferred because this grid is already fine enough for the next split/ODE comparison.",
      "timeStepMatrix": "Use dtImplicit in [1e-7, 2e-7, 4e-7]. Set nTimeStep to [8500, 4250, 2125], respectively, so every row reaches tEnd=8.5e-4.",
      "odeMatrix": "ODE methods remain deliberately undecided. odeCode=0 and sourceStrangSplitting=0 below only make the base parseable; override odeCode, split treatment, output path, dtImplicit, and nTimeStep for every recorded row.",
      "initialization": "Before any quantitative run, replace exprtkInitializers with the round-trip-safe fitted laboratory-frame ZND initializer tracked at workspace/reaction_region_indicator/studies/h2o2_cj_dt_convergence/configs/znd_lab_initializer.json. The compact tanh field below is a non-quantitative placeholder only.",
      "execution": "No matrix row was run when this base was created. Launch future rows from build/ with np=64 on the authorized direct-SSH runner and record exact -k/-v overlays and hashes."
    }
  },
